# Required: the secret in the edit link (https://your-app.vercel.app/?k=EDIT_KEY). Use a long random string.
EDIT_KEY=
# Optional: a second key for view-only links. If you leave it blank, anyone with the site address can read the plan.
VIEW_KEY=

# Storage (set automatically when you add Upstash Redis from the Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: live hotel prices from Rakuten Travel (free: https://webservice.rakuten.co.jp/app/create)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# Your site address, sent to Rakuten as the referring site (e.g. https://japan-trip.vercel.app)
PUBLIC_URL=

# Your email, sent to OpenStreetMap services so they can contact you if something goes wrong (their usage policy asks for it)
CONTACT_EMAIL=

# Optional: change if you plan more than one trip on the same Redis database
TRIP_ID=japan-2027
