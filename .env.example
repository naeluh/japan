# Required: the secret in the edit link (https://your-app.vercel.app/?k=EDIT_KEY). Use a long random string.
EDIT_KEY=
# Recommended: a second key for view-only links. Blank means anyone with the site address can read the plan.
VIEW_KEY=
# Required for the nightly price watch: Vercel Cron sends it; nothing else can start that run without the edit key.
CRON_SECRET=

# Storage: a Neon Postgres connection string (free plan, no card: https://neon.tech). Blank = local file.
DATABASE_URL=

# Live hotel prices and the price watch: Rakuten Travel (free: https://webservice.rakuten.co.jp/app/create)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# Your site address, sent to Rakuten as the referring site and used for links in alert emails (e.g. https://japan-trip.vercel.app)
PUBLIC_URL=

# Email alerts through Resend (https://resend.com). ALERT_EMAIL can list both of you, comma-separated.
RESEND_API_KEY=
ALERT_EMAIL=
# Optional sender once you verify a domain in Resend (default: Trip planner <onboarding@resend.dev>)
ALERT_FROM=

# Your email, sent to OpenStreetMap services so they can contact you if something goes wrong (their usage policy asks for it)
CONTACT_EMAIL=

# Optional: change if you plan more than one trip on the same Redis database
TRIP_ID=japan-2027

# Local testing only: where the dev store lives, and the Rakuten stand-in from scripts/fakes.mjs
# LOCAL_DB_FILE=.local-db.json
# RAKUTEN_BASE=http://localhost:3918
